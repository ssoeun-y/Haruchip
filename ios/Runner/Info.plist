	     GoogleService-Info.plist의 REVERSED_CLIENT_ID와 동일해야 한다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.932846129523-ltb00kpjgot5s78a9n43iar45mt50ove</string>
			</array>
		</dict>
	</array>
	<!-- image_picker(카테고리 배경/아기·반려동물 프로필 사진, 카테고리&디데이
	     핸드오프 문서 §6)가 갤러리 접근 시 띄우는 권한 안내 문구. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>사진첩에서 카테고리 배경/프로필 사진을 선택하기 위해 접근합니다.</string>
