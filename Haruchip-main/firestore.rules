rules_version = '2';

// 하루칩 Firestore 보안 규칙 (CLAUDE.md §4, §9-1 Broken Access Control)
// - 기본 거부: 아래에 없는 경로는 전부 막힌다.
// - 모임방은 멤버(memberUids)만 읽고, 방장만 방 정보를 고친다.
// - 참가는 "본인 uid만 추가 + 이 방의 7일 이내 초대코드 제출"일 때만.
// - 초대코드는 코드를 아는 사람만 단건 조회 (목록 조회 금지 = 코드 훑어보기 차단).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/scheduleRooms/$(roomId);
    }

    function isMember(roomId) {
      return signedIn() && request.auth.uid in get(roomPath(roomId)).data.memberUids;
    }

    function isHost(roomId) {
      return signedIn() && get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }

    // 이 방의, 아직 만료되지 않은 초대코드인가
    function validCode(code, roomId) {
      let inv = get(/databases/$(database)/documents/inviteCodes/$(code));
      return inv.data.roomId == roomId && inv.data.expiresAt > request.time;
    }

    // ── 초대코드 (다회용, 7일) ─────────────────────────────
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      // 방장만 발급 (방 생성 batch 안에서도 되도록 getAfter), 만료는 최대 8일 뒤까지
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(roomPath(request.resource.data.roomId)).data.hostUid == request.auth.uid
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ── 모임방 ─────────────────────────────────────────────
    match /scheduleRooms/{roomId} {

      // 본인만 memberUids에 추가 + 같은 요청에서 만든 내 멤버 문서에 유효 코드
      function joiningSelf() {
        let added = request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet());
        let removed = resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet());
        let me = getAfter(/databases/$(database)/documents/scheduleRooms/$(roomId)/members/$(request.auth.uid));
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && added == [request.auth.uid].toSet()
          && removed.size() == 0
          && validCode(me.data.joinedWithCode, roomId);
      }

      // 본인만 memberUids에서 빠지기 (방 나가기)
      function leavingSelf() {
        let added = request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet());
        let removed = resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet());
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && removed == [request.auth.uid].toSet()
          && added.size() == 0
          && resource.data.hostUid != request.auth.uid;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      // 방장: 이름·설명·확정일·초대코드 변경 (방장/멤버 목록은 못 바꿈)
      allow update: if signedIn() && (
        (resource.data.hostUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.memberUids == resource.data.memberUids)
        || joiningSelf()
        || leavingSelf()
      );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      // 멤버 프로필 (이름·이모지·색)
      match /members/{memberUid} {
        allow read: if isMember(roomId);
        allow create: if signedIn()
          && memberUid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && (
            // 방 생성 batch의 방장 본인
            (!exists(roomPath(roomId))
              && getAfter(roomPath(roomId)).data.hostUid == request.auth.uid
              && request.resource.data.isHost == true)
            // 초대코드로 참가하는 본인
            || (request.resource.data.isHost == false
              && validCode(request.resource.data.joinedWithCode, roomId))
          );
        allow update: if isMember(roomId)
          && memberUid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.isHost == resource.data.isHost;
        allow delete: if signedIn() && (memberUid == request.auth.uid || isHost(roomId));
      }

      // 내 가능 날짜 — 각자 자기 문서만
      match /availability/{memberUid} {
        allow read: if isMember(roomId);
        allow write: if isMember(roomId) && memberUid == request.auth.uid;
      }

      // 확정 모임 댓글
      match /comments/{commentId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId) && request.resource.data.authorUid == request.auth.uid;
        allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isHost(roomId));
      }

      // 공유 캘린더 일정
      match /events/{eventId} {
        allow read: if isMember(roomId);
        allow create: if isMember(roomId) && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if isMember(roomId)
          && (resource.data.authorUid == request.auth.uid || isHost(roomId));
      }
    }
  }
}
